# Optional: enables live AI assistance. Never expose this in the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Optional: enables microphone transcription into the desktop assistant prompt. Never expose this in the browser.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3

# Required only when enabling the production Supabase adapter.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
